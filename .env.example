# SpecGuard-AA Real LLM Provider Configuration
# Choose one provider: 'anthropic' or 'openai'
LLM_PROVIDER=anthropic

# Provider API Keys (Fill in your key in .env, NOT here)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default Model Selection
# For Anthropic: claude-3-5-sonnet-20241022 or claude-3-haiku-20240307
# For OpenAI: gpt-4o or gpt-4o-mini
LLM_MODEL=claude-3-5-sonnet-20241022
